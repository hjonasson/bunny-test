{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "src/testing-library-bundle.js"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "debug*.ts",
    "explore.ts"
  ]
}